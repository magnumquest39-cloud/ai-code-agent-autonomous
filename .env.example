# Environment variables for AI Code Agent Autonomous

# GitHub API
GITHUB_TOKEN=your_github_token_here

# Hugging Face
HF_API_TOKEN=your_huggingface_token_here

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Agent Configuration
AGENT_MODE=autonomous
AGENT_MODEL=codellama
AGENT_VERBOSE=true

# Server
PORT=3000
HOST=0.0.0.0

# Development
NODE_ENV=development
DEBUG=true
